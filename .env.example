# ============================================
# enzo-films - Environment Variables
# ============================================
# Copy this file to .env and adjust values.
#   cp .env.example .env
# ============================================

# --- Database ---
# PostgreSQL connection string (used by Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# For Docker: use postgresql://opencode:opencode@db:5432/opencode?schema=public
# For local dev: use postgresql://opencode:opencode@localhost:5432/opencode?schema=public
DATABASE_URL="postgresql://opencode:opencode@localhost:5432/opencode?schema=public"

# --- Auth ---
# Secret key for signing JWT tokens.
# CHANGE THIS in production to a strong random value.
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret

# --- Environment ---
# Set to 'production' in production, 'development' for local dev.
# Controls cookie Secure flag and other production behaviors.
NODE_ENV=development
